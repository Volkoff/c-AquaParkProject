<Window x:Class="AquaParkManager.Windows.AttractionsManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Attractions Management" Height="600" Width="1000" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#FF2E86AB" Padding="15">
            <StackPanel>
                <TextBlock Text="🎯 Attractions Management" 
                          FontSize="20" 
                          FontWeight="Bold" 
                          Foreground="White"/>
                <TextBlock Text="Manage park attractions and their status" 
                          FontSize="12" 
                          Foreground="White" 
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Attractions List -->
            <GroupBox Grid.Column="0" Header="Attractions" FontWeight="Bold">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Search and Add Button -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="txtSearch" 
                                Width="200" 
                                Height="30" 
                                VerticalContentAlignment="Center"
                                TextChanged="TxtSearch_TextChanged"
                                Tag="Search attractions..."/>
                        <Button x:Name="btnAddAttraction" 
                               Content="➕ Add Attraction" 
                               Margin="10,0,0,0" 
                               Padding="15,5"
                               Background="#FF28A745"
                               Foreground="White"
                               BorderThickness="0"
                               Click="BtnAddAttraction_Click"/>
                    </StackPanel>
                    
                    <!-- Attractions DataGrid -->
                    <DataGrid x:Name="dgAttractions" 
                             Grid.Row="1" 
                             AutoGenerateColumns="False" 
                             CanUserAddRows="False"
                             SelectionChanged="DgAttractions_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding AttractionId}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding AttractionType}" Width="100"/>
                            <DataGridTextColumn Header="Object ID" Binding="{Binding ObjectId}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Capacity" Binding="{Binding Capacity}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
            
            <!-- Details Panel -->
            <GroupBox Grid.Column="2" Header="Attraction Details" FontWeight="Bold">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="Attraction Name:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtName" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Attraction Type:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbAttractionType" Margin="0,0,0,10">
                            <ComboBoxItem Content="SLIDE"/>
                            <ComboBoxItem Content="POOL"/>
                            <ComboBoxItem Content="WAVE_POOL"/>
                            <ComboBoxItem Content="RIVER"/>
                        </ComboBox>
                        
                        <TextBlock Text="Object ID:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtObjectId" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbStatus" Margin="0,0,0,10">
                            <ComboBoxItem Content="OPEN" IsSelected="True"/>
                            <ComboBoxItem Content="CLOSED"/>
                            <ComboBoxItem Content="MAINTENANCE"/>
                            <ComboBoxItem Content="TEMP_CLOSED"/>
                        </ComboBox>
                        
                        <TextBlock Text="Capacity:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtCapacity" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Notes:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNotes" 
                                Height="80" 
                                TextWrapping="Wrap" 
                                AcceptsReturn="True" 
                                VerticalScrollBarVisibility="Auto"
                                Margin="0,0,0,15"/>
                        
                        <!-- Action Buttons -->
                        <Button x:Name="btnSave" 
                               Content="💾 Save" 
                               Background="#FF007BFF" 
                               Foreground="White" 
                               BorderThickness="0"
                               Padding="10,5"
                               Margin="0,0,0,5"
                               Click="BtnSave_Click"/>
                        
                        <Button x:Name="btnDelete" 
                               Content="🗑️ Delete" 
                               Background="#FFDC3545" 
                               Foreground="White" 
                               BorderThickness="0"
                               Padding="10,5"
                               Margin="0,0,0,5"
                               Click="BtnDelete_Click"/>
                        
                        <Button x:Name="btnClear" 
                               Content="🔄 Clear" 
                               Background="#FF6C757D" 
                               Foreground="White" 
                               BorderThickness="0"
                               Padding="10,5"
                               Click="BtnClear_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#FFF8F9FA">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
