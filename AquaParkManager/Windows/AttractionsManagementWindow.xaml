<Window x:Class="AquaParkManager.Windows.AttractionsManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attractions Management" Height="500" Width="1000" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF2E86AB" Padding="15">
            <StackPanel>
                <TextBlock Text="🎯 Attractions Management" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Manage park attractions and their status" FontSize="12" Foreground="White" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Attractions" FontWeight="Bold">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="txtSearch" Width="200" Height="30" VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                        <Button x:Name="btnAddAttraction" Content="➕ Add Attraction" Margin="10,0,0,0" Padding="15,5" Background="#FF28A745" Foreground="White" BorderThickness="0" Click="BtnAddAttraction_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="dgAttractions" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="DgAttractions_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding AttractionId}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Pool.Name}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Attraction Details" FontWeight="Bold">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="Attraction Name:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtName" Margin="0,0,0,10"/>

                        <TextBlock Text="Location (Area):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbArea" Margin="0,0,0,10" DisplayMemberPath="Name" SelectedValuePath="PoolId"/>

                        <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbStatus" Margin="0,0,0,15">
                            <ComboBoxItem Content="OPEN" IsSelected="True"/>
                            <ComboBoxItem Content="CLOSED"/>
                            <ComboBoxItem Content="MAINTENANCE"/>
                        </ComboBox>

                        <Button x:Name="btnSave" Content="💾 Save" Background="#FF007BFF" Foreground="White" BorderThickness="0" Padding="10,5" Margin="0,0,0,5" Click="BtnSave_Click"/>
                        <Button x:Name="btnDelete" Content="🗑️ Delete" Background="#FFDC3545" Foreground="White" BorderThickness="0" Padding="10,5" Margin="0,0,0,5" Click="BtnDelete_Click"/>
                        <Button x:Name="btnClear" Content="🔄 Clear" Background="#FF6C757D" Foreground="White" BorderThickness="0" Padding="10,5" Click="BtnClear_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="2" Background="#FFF8F9FA">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>