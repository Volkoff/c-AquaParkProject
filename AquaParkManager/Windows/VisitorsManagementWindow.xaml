<Window x:Class="AquaParkManager.Windows.VisitorsManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Visitors Management" Height="600" Width="1000" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#FF2E86AB" Padding="15">
            <StackPanel>
                <TextBlock Text="👤 Visitors Management" 
                          FontSize="20" 
                          FontWeight="Bold" 
                          Foreground="White"/>
                <TextBlock Text="Manage visitor information and profiles" 
                          FontSize="12" 
                          Foreground="White" 
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Visitors List -->
            <GroupBox Grid.Column="0" Header="Visitors" FontWeight="Bold">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Search and Add Button -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="txtSearch" 
                                Width="200" 
                                Height="30" 
                                VerticalContentAlignment="Center"
                                TextChanged="TxtSearch_TextChanged"
                                Tag="Search visitors..."/>
                        <Button x:Name="btnAddVisitor" 
                               Content="➕ Add Visitor" 
                               Margin="10,0,0,0" 
                               Padding="15,5"
                               Background="#FF28A745"
                               Foreground="White"
                               BorderThickness="0"
                               Click="BtnAddVisitor_Click"/>
                    </StackPanel>
                    
                    <!-- Visitors DataGrid -->
                    <DataGrid x:Name="dgVisitors" 
                             Grid.Row="1" 
                             AutoGenerateColumns="False" 
                             CanUserAddRows="False"
                             SelectionChanged="DgVisitors_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding VisitorId}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="120"/>
                            <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="120"/>
                            <DataGridTextColumn Header="Date of Birth" Binding="{Binding DateOfBirth, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="100"/>
                            <DataGridTextColumn Header="Emergency Contact" Binding="{Binding EmergencyContact}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
            
            <!-- Details Panel -->
            <GroupBox Grid.Column="2" Header="Visitor Details" FontWeight="Bold">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="First Name:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtFirstName" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Last Name:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtLastName" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Date of Birth:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpDateOfBirth" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Email:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtEmail" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Phone:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtPhone" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Emergency Contact:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtEmergencyContact" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Notes:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNotes" 
                                Height="80" 
                                TextWrapping="Wrap" 
                                AcceptsReturn="True" 
                                VerticalScrollBarVisibility="Auto"
                                Margin="0,0,0,15"/>
                        
                        <!-- Action Buttons -->
                        <Button x:Name="btnSave" 
                               Content="💾 Save" 
                               Background="#FF007BFF" 
                               Foreground="White" 
                               BorderThickness="0"
                               Padding="10,5"
                               Margin="0,0,0,5"
                               Click="BtnSave_Click"/>
                        
                        <Button x:Name="btnDelete" 
                               Content="🗑️ Delete" 
                               Background="#FFDC3545" 
                               Foreground="White" 
                               BorderThickness="0"
                               Padding="10,5"
                               Margin="0,0,0,5"
                               Click="BtnDelete_Click"/>
                        
                        <Button x:Name="btnClear" 
                               Content="🔄 Clear" 
                               Background="#FF6C757D" 
                               Foreground="White" 
                               BorderThickness="0"
                               Padding="10,5"
                               Click="BtnClear_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#FFF8F9FA">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
