<Window x:Class="AquaParkManager.Windows.VisitorsManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visitors Management" Height="550" Width="1000" WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="15">
            <StackPanel>
                <TextBlock Text="👤 Visitors Management" Style="{StaticResource HeaderTitleStyle}"/>
                <TextBlock Text="Manage visitor profiles (Address required)" Style="{StaticResource HeaderSubTitleStyle}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Visitors" FontWeight="Bold">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="txtSearch" Width="200" Height="30" VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                        <Button x:Name="btnAddVisitor" Content="➕ Add Visitor" Margin="10,0,0,0" Padding="15,5" Style="{StaticResource AddButtonStyle}" Click="BtnAddVisitor_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="dgVisitors" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="DgVisitors_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding VisitorId}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="100"/>
                            <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="100"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Visitor Details" FontWeight="Bold">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="First Name:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtFirstName" Margin="0,0,0,10"/>

                        <TextBlock Text="Last Name:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtLastName" Margin="0,0,0,10"/>

                        <TextBlock Text="Date of Birth:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpDateOfBirth" Margin="0,0,0,10"/>

                        <TextBlock Text="Email:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtEmail" Margin="0,0,0,10"/>

                        <TextBlock Text="Phone:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtPhone" Margin="0,0,0,10"/>

                        <GroupBox Header="Address (Required)" Margin="0,10,0,10" Padding="5">
                            <StackPanel>
                                <TextBlock Text="Street:" FontWeight="Bold"/>
                                <TextBox x:Name="txtStreet" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock Text="House No.:" FontWeight="Bold"/>
                                        <TextBox x:Name="txtHouseNumber" Margin="0,0,0,5"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="ZIP:" FontWeight="Bold"/>
                                        <TextBox x:Name="txtZip" Margin="0,0,0,5"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="City:" FontWeight="Bold"/>
                                <TextBox x:Name="txtCity" Margin="0,0,0,5"/>
                                <TextBlock Text="Region:" FontWeight="Bold"/>
                                <TextBox x:Name="txtRegion" Text="Pardubický kraj" Margin="0,0,0,5"/>
                                <TextBlock Text="Country:" FontWeight="Bold"/>
                                <TextBox x:Name="txtCountry" Text="Česká republika" Margin="0,0,0,5"/>
                            </StackPanel>
                        </GroupBox>

                        <TextBlock Text="Notes:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNotes" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

                        <Button x:Name="btnSave" Content="💾 Save" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,0,0,5" Click="BtnSave_Click"/>
                        <Button x:Name="btnDelete" Content="🗑️ Delete" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,5" Click="BtnDelete_Click"/>
                        <Button x:Name="btnClear" Content="🔄 Clear" Style="{StaticResource NeutralButtonStyle}" Click="BtnClear_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="2" Background="{StaticResource StatusBarBrush}">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>