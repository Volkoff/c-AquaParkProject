<Window x:Class="AquaParkManager.Windows.SalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sales &amp; CRM" Height="700" Width="1200" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="LightGray" Padding="10">
            <TextBlock Text="Sales &amp; CRM" FontSize="18" FontWeight="Bold"/>
        </Border>

        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="Visitors">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid Name="dgVisitors" Grid.Column="0" AutoGenerateColumns="False" SelectionChanged="DgVisitors_SelectionChanged" IsReadOnly="True" BorderBrush="#CCC" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GroupBox Grid.Column="2" Header="Visitor Profile">
                        <StackPanel>
                            <TextBlock Text="First Name:"/>
                            <TextBox Name="txtVisFn" Margin="0,2"/>

                            <TextBlock Text="Last Name:"/>
                            <TextBox Name="txtVisLn" Margin="0,2"/>

                            <TextBlock Text="Email:"/>
                            <TextBox Name="txtVisEmail" Margin="0,2"/>

                            <TextBlock Text="Phone:"/>
                            <TextBox Name="txtVisPhone" Margin="0,2"/>

                            <TextBlock Text="Birth Date:"/>
                            <DatePicker Name="dpVisBirth" Margin="0,2"/>

                            <TextBlock Text="City/Address:" Margin="0,5,0,0" FontWeight="Bold"/>
                            <TextBox Name="txtVisAddr" Margin="0,2" ToolTip="Enter City name"/>

                            <Border Background="#EEE" Margin="0,10,0,5" Padding="5" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock Text="📊 Visitor Stats (DB)" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <TextBlock Name="txtVisStats" Text="Select a visitor..." Foreground="Blue" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Button Content="💾 Save Visitor" Click="BtnSaveVisitor_Click" Margin="0,10,0,5"/>
                            <Button Content="➕ New" Click="BtnNewVisitor_Click"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Bookings &amp; POS">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid Name="dgBookings" Grid.Column="0" AutoGenerateColumns="False" SelectionChanged="DgBookings_SelectionChanged" IsReadOnly="True" BorderBrush="#CCC" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ref" Binding="{Binding BookingRef}"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=C}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Column="2">
                        <GroupBox Header="Create Booking">
                            <StackPanel>
                                <TextBlock Text="Customer:"/>
                                <ComboBox Name="cmbBookVisitor" DisplayMemberPath="FullName" SelectedValuePath="VisitorId" Margin="0,5"/>
                                <Button Content="New Booking" Click="BtnCreateBooking_Click"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Add Item" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Type:"/>
                                <ComboBox Name="cmbTicketType" DisplayMemberPath="Name" SelectedValuePath="TicketTypeId" Margin="0,5"/>
                                <TextBlock Text="Price:"/>
                                <TextBox Name="txtPrice" Text="100" Margin="0,5"/>
                                <Button Content="Add Ticket" Click="BtnAddTicket_Click"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Payment" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Amount:"/>
                                <TextBox Name="txtPayAmount" Margin="0,5"/>
                                <Button Content="Pay" Click="BtnPay_Click" Margin="0,5"/>
                                <Separator Margin="0,5"/>
                                <Button Content="❌ Cancel Booking" Click="BtnCancelBooking_Click" Background="#FFDDDD"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Memberships &amp; Loyalty">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Memberships">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid Name="dgMemberships" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Visitor" Binding="{Binding Visitor.FullName}"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding MembershipType}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Visitor:"/>
                                <ComboBox Name="cmbMemVisitor" DisplayMemberPath="FullName" SelectedValuePath="VisitorId"/>
                                <TextBlock Text="Type:"/>
                                <TextBox Name="txtMemType" Text="Annual"/>
                                <Button Content="Add Membership" Click="BtnAddMem_Click" Margin="0,5"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Loyalty &amp; Waivers">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid Name="dgLoyalty" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Visitor" Binding="{Binding Visitor.FullName}"/>
                                    <DataGridTextColumn Header="Points" Binding="{Binding Earned}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Visitor:"/>
                                <ComboBox Name="cmbLoyVis" DisplayMemberPath="FullName" SelectedValuePath="VisitorId"/>
                                <TextBlock Text="Points:"/>
                                <TextBox Name="txtPoints"/>
                                <Button Content="Set Points" Click="BtnSetPoints_Click" Margin="0,5"/>
                                <Button Content="🔄 Run Monthly Tier Update" Click="BtnUpdateTiers_Click" Margin="0,5" ToolTip="Calls SP_UPDATE_LOYALTY_TIERS"/>
                                <Separator Margin="0,5"/>
                                <TextBlock Text="Waiver Type:"/>
                                <TextBox Name="txtWaiver"/>
                                <Button Content="Add Waiver" Click="BtnAddWaiver_Click" Margin="0,5"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>