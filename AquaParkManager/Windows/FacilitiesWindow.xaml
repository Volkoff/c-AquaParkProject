<Window x:Class="AquaParkManager.Windows.FacilitiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Facilities Management" Height="700" Width="1100" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#EEE" Padding="15" BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <TextBlock Text="🏭 Facilities Management (Full DB Coverage)" FontSize="20" FontWeight="Bold"/>
        </Border>

        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="Attractions">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Name="btnLoadAttr" Content="🔄 Refresh" Width="80" HorizontalAlignment="Left" Click="BtnLoadAttr_Click" Margin="0,0,0,10"/>
                        <DataGrid Name="dgAttractions" Grid.Row="1" AutoGenerateColumns="False" SelectionChanged="DgAttractions_SelectionChanged" IsReadOnly="True" BorderBrush="#CCC" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding SlideType.Name}" Width="100"/>
                                <DataGridTextColumn Header="Pool" Binding="{Binding Pool.Name}" Width="100"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <GroupBox Grid.Column="2" Header="Attraction Details">
                        <StackPanel>
                            <TextBlock Text="Name:" FontWeight="Bold"/>
                            <TextBox Name="txtAttrName" Margin="0,5"/>
                            <TextBlock Text="Pool:" FontWeight="Bold"/>
                            <ComboBox Name="cmbAttrPool" Margin="0,5" DisplayMemberPath="Name" SelectedValuePath="PoolId"/>
                            <TextBlock Text="Type:" FontWeight="Bold"/>
                            <ComboBox Name="cmbAttrType" Margin="0,5" DisplayMemberPath="Name" SelectedValuePath="SlideTypeId"/>
                            <TextBlock Text="Status:" FontWeight="Bold"/>
                            <ComboBox Name="cmbAttrStatus" Margin="0,5" SelectedValuePath="Content">
                                <ComboBoxItem Content="OPEN"/>
                                <ComboBoxItem Content="CLOSED"/>
                                <ComboBoxItem Content="MAINTENANCE"/>
                            </ComboBox>
                            <Button Content="💾 Save / Update" Click="BtnSaveAttr_Click" Margin="0,10"/>
                            <Button Content="➕ Clear Form" Click="BtnAddAttr_Click"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Maintenance">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid Name="dgMaint" AutoGenerateColumns="False" IsReadOnly="True" BorderBrush="#CCC" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding ReportDate, StringFormat=dd.MM.yyyy}"/>
                            <DataGridTextColumn Header="Reported By" Binding="{Binding Staff.FullName}"/>
                            <DataGridTextColumn Header="Desc" Binding="{Binding ProblemDescription}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GroupBox Grid.Column="2" Header="New Log Entry">
                        <StackPanel>
                            <TextBlock Text="Staff:" FontWeight="Bold"/>
                            <ComboBox Name="cmbMaintStaff" DisplayMemberPath="FullName" SelectedValuePath="StaffId" Margin="0,5"/>
                            <TextBlock Text="Description:" FontWeight="Bold"/>
                            <TextBox Name="txtMaintDesc" Height="100" TextWrapping="Wrap" Margin="0,5"/>
                            <Button Content="➕ Add Record" Click="BtnAddMaint_Click" Margin="0,10"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Inventory">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Name="dgInv" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10" BorderBrush="#CCC" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}"/>
                            <DataGridTextColumn Header="Min" Binding="{Binding MinStock}"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=C}"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier.Name}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GroupBox Grid.Row="1" Header="Add Stock Item">
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <TextBlock Text="Name:" VerticalAlignment="Center"/>
                            <TextBox Name="txtInvName" Width="120" Margin="5,0"/>

                            <TextBlock Text="Qty:" VerticalAlignment="Center"/>
                            <TextBox Name="txtInvQty" Width="40" Margin="5,0"/>

                            <TextBlock Text="Min:" VerticalAlignment="Center"/>
                            <TextBox Name="txtInvMin" Width="40" Margin="5,0" Text="10"/>

                            <TextBlock Text="Price:" VerticalAlignment="Center"/>
                            <TextBox Name="txtInvPrice" Width="50" Margin="5,0"/>

                            <TextBlock Text="Supplier:" VerticalAlignment="Center"/>
                            <ComboBox Name="cmbInvSup" Width="120" DisplayMemberPath="Name" SelectedValuePath="SupplierId" Margin="5,0"/>

                            <Button Content="Add" Click="BtnAddInv_Click" Width="80"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Concessions">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid Name="dgConcessions" AutoGenerateColumns="False" IsReadOnly="True" BorderBrush="#CCC" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Stand Name" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="Location ID" Binding="{Binding AreaId}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GroupBox Grid.Column="2" Header="New Stand">
                        <StackPanel>
                            <TextBlock Text="Name:" FontWeight="Bold"/>
                            <TextBox Name="txtConcName" Margin="0,5"/>
                            <TextBlock Text="Location (Pool/Area):" FontWeight="Bold"/>
                            <ComboBox Name="cmbConcArea" DisplayMemberPath="Name" SelectedValuePath="PoolId" Margin="0,5"/>
                            <TextBlock Text="Status:" FontWeight="Bold"/>
                            <ComboBox Name="cmbConcStatus" Margin="0,5" SelectedValuePath="Content">
                                <ComboBoxItem Content="OPEN"/>
                                <ComboBoxItem Content="CLOSED"/>
                            </ComboBox>
                            <Button Content="➕ Add Concession" Click="BtnAddConc_Click" Margin="0,10"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Safety &amp; Weather">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Safety Standards">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid Name="dgSafety" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Standard" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="New Standard Name:"/>
                                <TextBox Name="txtSafeName" Margin="0,2"/>
                                <TextBlock Text="Description:"/>
                                <TextBox Name="txtSafeDesc" Margin="0,2"/>
                                <Button Content="Add Standard" Click="BtnAddSafe_Click" Margin="0,5"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Weather Log">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid Name="dgWeather" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding RecordDate, StringFormat=g}"/>
                                    <DataGridTextColumn Header="Temp" Binding="{Binding Temperature}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Temperature (°C):"/>
                                <TextBox Name="txtWeatherTemp" Margin="0,2"/>
                                <Button Content="Log Weather" Click="BtnAddWeather_Click" Margin="0,5"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>