<Window x:Class="AquaParkManager.Windows.SlidesManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slides Management" Height="500" Width="1000" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="15">
            <StackPanel>
                <TextBlock Text="🎢 Slides Management" Style="{StaticResource HeaderTitleStyle}"/>
                <TextBlock Text="Add and manage slides and safety info" Style="{StaticResource HeaderSubTitleStyle}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Water Slides" FontWeight="Bold">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="txtSearch" Width="200" Height="30" VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                        <Button x:Name="btnAddSlide" Content="➕ Add Slide" Margin="10,0,0,0" Padding="15,5" Style="{StaticResource AddButtonStyle}" Click="BtnAddSlide_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="dgSlides" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="DgSlides_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding AttractionId}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding SlideType.Name}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="Pool (Area)" Binding="{Binding Pool.Name}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Slide Details" FontWeight="Bold">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="Slide Name:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtName" Margin="0,0,0,10"/>

                        <TextBlock Text="Slide Type:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbSlideType" Margin="0,0,0,10"/>

                        <TextBlock Text="Location (Pool/Area):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbPool" Margin="0,0,0,10"/>

                        <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbStatus" Margin="0,0,0,15">
                            <ComboBoxItem Content="OPEN" IsSelected="True"/>
                            <ComboBoxItem Content="CLOSED"/>
                            <ComboBoxItem Content="MAINTENANCE"/>
                        </ComboBox>

                        <Button x:Name="btnSave" Content="💾 Save" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,0,0,5" Click="BtnSave_Click"/>
                        <Button x:Name="btnDelete" Content="🗑️ Delete" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,5" Click="BtnDelete_Click"/>
                        <Button x:Name="btnClear" Content="🔄 Clear" Style="{StaticResource NeutralButtonStyle}" Click="BtnClear_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="2" Background="{StaticResource StatusBarBrush}">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>