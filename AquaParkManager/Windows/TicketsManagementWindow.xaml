<Window x:Class="AquaParkManager.Windows.TicketsManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tickets Management" Height="600" Width="1200" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#FF2E86AB" Padding="15">
            <StackPanel>
                <TextBlock Text="🎫 Tickets Management" 
                          FontSize="20" 
                          FontWeight="Bold" 
                          Foreground="White"/>
                <TextBlock Text="Manage tickets and ticket types" 
                          FontSize="12" 
                          Foreground="White" 
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Tickets List -->
            <GroupBox Grid.Column="0" Header="Tickets" FontWeight="Bold">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Search and Add Button -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="txtSearch" 
                                Width="200" 
                                Height="30" 
                                VerticalContentAlignment="Center"
                                TextChanged="TxtSearch_TextChanged"
                                Tag="Search tickets..."/>
                        <Button x:Name="btnAddTicket" 
                               Content="➕ Add Ticket" 
                               Margin="10,0,0,0" 
                               Padding="15,5"
                               Background="#FF28A745"
                               Foreground="White"
                               BorderThickness="0"
                               Click="BtnAddTicket_Click"/>
                    </StackPanel>
                    
                    <!-- Tickets DataGrid -->
                    <DataGrid x:Name="dgTickets" 
                             Grid.Row="1" 
                             AutoGenerateColumns="False" 
                             CanUserAddRows="False"
                             SelectionChanged="DgTickets_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding TicketId}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TicketType.Name}" Width="120"/>
                            <DataGridTextColumn Header="Visitor" Binding="{Binding Visitor.FirstName}" Width="100"/>
                            <DataGridTextColumn Header="Purchase Date" Binding="{Binding PurchaseDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Valid From" Binding="{Binding ValidFrom, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Valid To" Binding="{Binding ValidTo, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Price Paid" Binding="{Binding PricePaid, StringFormat=C}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
            
            <!-- Details Panel -->
            <GroupBox Grid.Column="2" Header="Ticket Details" FontWeight="Bold">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="Ticket Type:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbTicketType" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Visitor:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbVisitor" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Purchase Date:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpPurchaseDate" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Valid From:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpValidFrom" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Valid To:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpValidTo" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Price Paid:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtPricePaid" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbStatus" Margin="0,0,0,15">
                            <ComboBoxItem Content="ACTIVE" IsSelected="True"/>
                            <ComboBoxItem Content="USED"/>
                            <ComboBoxItem Content="REFUNDED"/>
                            <ComboBoxItem Content="CANCELLED"/>
                        </ComboBox>
                        
                        <!-- Action Buttons -->
                        <Button x:Name="btnSave" 
                               Content="💾 Save" 
                               Background="#FF007BFF" 
                               Foreground="White" 
                               BorderThickness="0"
                               Padding="10,5"
                               Margin="0,0,0,5"
                               Click="BtnSave_Click"/>
                        
                        <Button x:Name="btnDelete" 
                               Content="🗑️ Delete" 
                               Background="#FFDC3545" 
                               Foreground="White" 
                               BorderThickness="0"
                               Padding="10,5"
                               Margin="0,0,0,5"
                               Click="BtnDelete_Click"/>
                        
                        <Button x:Name="btnClear" 
                               Content="🔄 Clear" 
                               Background="#FF6C757D" 
                               Foreground="White" 
                               BorderThickness="0"
                               Padding="10,5"
                               Click="BtnClear_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#FFF8F9FA">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
