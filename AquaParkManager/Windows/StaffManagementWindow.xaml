<Window x:Class="AquaParkManager.Windows.StaffManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Staff Management" Height="600" Width="1000" WindowStartupLocation="CenterScreen" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="15">
            <StackPanel>
                <TextBlock Text="👥 Staff Management" Style="{StaticResource HeaderTitleStyle}"/>
                <TextBlock Text="Manage staff members, roles, and certifications" Style="{StaticResource HeaderSubTitleStyle}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Staff List -->
            <GroupBox Grid.Column="0" Header="Staff Members" FontWeight="Bold">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Search and Add Button -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="txtSearch" 
                                Width="200" 
                                Height="30" 
                                VerticalContentAlignment="Center"
                                TextChanged="TxtSearch_TextChanged"
                                Tag="Search staff..."/>
                           <Button x:Name="btnAddStaff" 
                               Content="➕ Add Staff" 
                               Margin="10,0,0,0" 
                               Padding="15,5"
                               Style="{StaticResource AddButtonStyle}"
                               Click="BtnAddStaff_Click"/>
                    </StackPanel>
                    
                    <!-- Staff DataGrid -->
                    <DataGrid x:Name="dgStaff" 
                             Grid.Row="1" 
                             AutoGenerateColumns="False" 
                             CanUserAddRows="False"
                             SelectionChanged="DgStaff_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding StaffId}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="120"/>
                            <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="120"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="100"/>
                            <DataGridTextColumn Header="Job Title" Binding="{Binding JobTitle}" Width="120"/>
                            <DataGridTextColumn Header="Hire Date" Binding="{Binding HireDate, StringFormat=dd/MM/yyyy}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Active" Binding="{Binding Active}" Width="60" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
            
            <!-- Details Panel -->
            <GroupBox Grid.Column="2" Header="Staff Details" FontWeight="Bold">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="First Name:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtFirstName" Margin="0,0,0,10"/>

                        <TextBlock Text="Last Name:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtLastName" Margin="0,0,0,10"/>

                        <TextBlock Text="Email:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtEmail" Margin="0,0,0,10"/>

                        <TextBlock Text="Phone:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtPhone" Margin="0,0,0,10"/>

                        <GroupBox Header="Adresa" Margin="0,10,0,10" Padding="5">
                            <StackPanel>
                                <TextBlock Text="Ulice:" FontWeight="Bold"/>
                                <TextBox x:Name="txtStreet" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock Text="Číslo popisné:" FontWeight="Bold"/>
                                        <TextBox x:Name="txtHouseNumber" Margin="0,0,0,5"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="PSČ:" FontWeight="Bold"/>
                                        <TextBox x:Name="txtZip" Margin="0,0,0,5"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Město:" FontWeight="Bold"/>
                                <TextBox x:Name="txtCity" Margin="0,0,0,5"/>
                                <TextBlock Text="Region (Kraj):" FontWeight="Bold"/>
                                <TextBox x:Name="txtRegion" Text="Pardubický kraj" Margin="0,0,0,5"/>
                                <TextBlock Text="Země:" FontWeight="Bold"/>
                                <TextBox x:Name="txtCountry" Text="Česká republika" Margin="0,0,0,5"/>
                            </StackPanel>
                        </GroupBox>

                        <Border BorderBrush="LightGray" BorderThickness="1" Padding="5" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="PŘIHLAŠOVACÍ ÚDAJE" Foreground="Blue" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="Uživatelské jméno (Login):" FontWeight="Bold"/>
                                <TextBox x:Name="txtUsername" Margin="0,0,0,5"/>
                                <TextBlock Text="Heslo:" FontWeight="Bold"/>
                                <PasswordBox x:Name="txtPassword" Margin="0,0,0,5"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Assigned Roles:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Border BorderBrush="#FFABADB3" BorderThickness="1" CornerRadius="2" Margin="0,0,0,10">
                            <ListBox x:Name="lstRoles" Height="100" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding RoleName}" IsChecked="{Binding IsSelected}" Margin="2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <TextBlock Text="Hire Date:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpHireDate" Margin="0,0,0,10"/>

                        <CheckBox x:Name="chkActive" Content="Active" Margin="0,0,0,10"/>

                        <TextBlock Text="Notes:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNotes" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnSave" Content="💾 Save" Width="90" Height="30" Margin="0,0,5,0" Style="{StaticResource PrimaryActionButtonStyle}" Click="BtnSave_Click"/>
                            <Button x:Name="btnDelete" Content="🗑️ Delete" Width="90" Height="30" Margin="0,0,5,0" Style="{StaticResource DangerButtonStyle}" Click="BtnDelete_Click"/>
                            <Button x:Name="btnClear" Content="🔄 Clear" Width="90" Height="30" Style="{StaticResource NeutralButtonStyle}" Click="BtnClear_Click"/>
                        </StackPanel>

                        <Border Height="20"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="{StaticResource StatusBarBrush}">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
