<Window x:Class="AquaParkManager.Windows.DatabaseObjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Systémový Katalog (DB Objekty)" Height="500" Width="600" WindowStartupLocation="CenterScreen">
    <Grid>
        <DataGrid x:Name="dgObjects" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Typ" Binding="{Binding ObjectType}" Width="150"/>
                <DataGridTextColumn Header="Název" Binding="{Binding ObjectName}" Width="*"/>
                <DataGridTextColumn Header="Stav" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>