<Window x:Class="AquaParkManager.Windows.PoolsManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pools Management" Height="500" Width="1000" WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="15">
            <StackPanel>
                <TextBlock Text="🏊 Pools Management" Style="{StaticResource HeaderTitleStyle}"/>
                <TextBlock Text="Manage swimming pools (Park Areas)" Style="{StaticResource HeaderSubTitleStyle}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Swimming Pools" FontWeight="Bold">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="txtSearch" Width="200" Height="30" VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                        <Button x:Name="btnAddPool" Content="➕ Add Pool" Margin="10,0,0,0" Padding="15,5" Style="{StaticResource AddButtonStyle}" Click="BtnAddPool_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="dgPools" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="DgPools_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding PoolId}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Capacity" Binding="{Binding Capacity}" Width="80"/>
                            <DataGridTextColumn Header="Indoors" Binding="{Binding Indoors}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Pool Details" FontWeight="Bold">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="Pool Name:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtName" Margin="0,0,0,10"/>

                        <TextBlock Text="Capacity:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtCapacity" Margin="0,0,0,10"/>

                        <CheckBox x:Name="chkIndoors" Content="Indoors Pool" Margin="0,0,0,10"/>

                        <TextBlock Text="Notes (Description):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNotes" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

                        <Button x:Name="btnSave" Content="💾 Save" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,0,0,5" Click="BtnSave_Click"/>
                        <Button x:Name="btnDelete" Content="🗑️ Delete" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,5" Click="BtnDelete_Click"/>
                        <Button x:Name="btnClear" Content="🔄 Clear" Style="{StaticResource NeutralButtonStyle}" Click="BtnClear_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="2" Background="{StaticResource StatusBarBrush}">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>