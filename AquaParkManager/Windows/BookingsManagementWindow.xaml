<Window x:Class="AquaParkManager.Windows.BookingsManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Bookings Management" Height="500" Width="1000" WindowStartupLocation="CenterScreen"
    Background="{StaticResource AppBackgroundBrush}"
        >

    <Grid Margin="0,0,0,-16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="15">
            <StackPanel>
                <TextBlock Text="📅 Bookings Management" Style="{StaticResource HeaderTitleStyle}"/>
                <TextBlock Text="Manage reservations (Total Amount is calculated by DB)" Style="{StaticResource HeaderSubTitleStyle}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Bookings" FontWeight="Bold">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="txtSearch" Width="200" Height="30" VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                        <Button x:Name="btnAddBooking" Content="➕ Add Booking" Margin="10,0,0,0" Padding="15,5" Style="{StaticResource AddButtonStyle}" Click="BtnAddBooking_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="dgBookings" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="DgBookings_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding BookingId}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Ref" Binding="{Binding BookingRef}" Width="100"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="150"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding CreatedDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=C}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Booking Details" FontWeight="Bold">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="Booking Reference:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtBookingRef" Margin="0,0,0,10"/>

                        <TextBlock Text="Customer:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbVisitor" Margin="0,0,0,10" DisplayMemberPath="FullName" SelectedValuePath="VisitorId"/>

                        <TextBlock Text="Created Date:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpCreatedDate" Margin="0,0,0,10"/>

                        <TextBlock Text="Total Amount (Auto-calc):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtTotalAmount" IsReadOnly="True" Background="#F0F0F0" Margin="0,0,0,10"/>

                        <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbStatus" Margin="0,0,0,10">
                            <ComboBoxItem Content="CONFIRMED" IsSelected="True"/>
                            <ComboBoxItem Content="CANCELLED"/>
                            <ComboBoxItem Content="PENDING"/>
                            <ComboBoxItem Content="COMPLETED"/>
                        </ComboBox>

                        <TextBlock Text="Notes:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNotes" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

                        <Button x:Name="btnSave" Content="💾 Save" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,0,0,5" Click="BtnSave_Click"/>
                        <Button x:Name="btnDelete" Content="🗑️ Delete" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,5" Click="BtnDelete_Click"/>
                        <Button x:Name="btnClear" Content="🔄 Clear" Style="{StaticResource NeutralButtonStyle}" Click="BtnClear_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="2" Background="{StaticResource StatusBarBrush}">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>