<Window x:Class="AquaParkManager.Windows.BookingsManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Bookings Management" Height="600" Width="1200" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#FF2E86AB" Padding="15">
            <StackPanel>
                <TextBlock Text="📅 Bookings Management" 
                          FontSize="20" 
                          FontWeight="Bold" 
                          Foreground="White"/>
                <TextBlock Text="Manage reservations and bookings" 
                          FontSize="12" 
                          Foreground="White" 
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Bookings List -->
            <GroupBox Grid.Column="0" Header="Bookings" FontWeight="Bold">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Search and Add Button -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="txtSearch" 
                                Width="200" 
                                Height="30" 
                                VerticalContentAlignment="Center"
                                TextChanged="TxtSearch_TextChanged"
                                Tag="Search bookings..."/>
                        <Button x:Name="btnAddBooking" 
                               Content="➕ Add Booking" 
                               Margin="10,0,0,0" 
                               Padding="15,5"
                               Background="#FF28A745"
                               Foreground="White"
                               BorderThickness="0"
                               Click="BtnAddBooking_Click"/>
                    </StackPanel>
                    
                    <!-- Bookings DataGrid -->
                    <DataGrid x:Name="dgBookings" 
                             Grid.Row="1" 
                             AutoGenerateColumns="False" 
                             CanUserAddRows="False"
                             SelectionChanged="DgBookings_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding BookingId}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Reference" Binding="{Binding BookingRef}" Width="100"/>
                            <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="150"/>
                            <DataGridTextColumn Header="Created Date" Binding="{Binding CreatedDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat=C}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
            
            <!-- Details Panel -->
            <GroupBox Grid.Column="2" Header="Booking Details" FontWeight="Bold">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="Booking Reference:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtBookingRef" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Customer Name:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtCustomerName" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Created Date:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpCreatedDate" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Total Amount:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtTotalAmount" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbStatus" Margin="0,0,0,10">
                            <ComboBoxItem Content="CONFIRMED" IsSelected="True"/>
                            <ComboBoxItem Content="CANCELLED"/>
                            <ComboBoxItem Content="PENDING"/>
                            <ComboBoxItem Content="COMPLETED"/>
                        </ComboBox>
                        
                        <TextBlock Text="Notes:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNotes" 
                                Height="80" 
                                TextWrapping="Wrap" 
                                AcceptsReturn="True" 
                                VerticalScrollBarVisibility="Auto"
                                Margin="0,0,0,15"/>
                        
                        <!-- Action Buttons -->
                        <Button x:Name="btnSave" 
                               Content="💾 Save" 
                               Background="#FF007BFF" 
                               Foreground="White" 
                               BorderThickness="0"
                               Padding="10,5"
                               Margin="0,0,0,5"
                               Click="BtnSave_Click"/>
                        
                        <Button x:Name="btnDelete" 
                               Content="🗑️ Delete" 
                               Background="#FFDC3545" 
                               Foreground="White" 
                               BorderThickness="0"
                               Padding="10,5"
                               Margin="0,0,0,5"
                               Click="BtnDelete_Click"/>
                        
                        <Button x:Name="btnClear" 
                               Content="🔄 Clear" 
                               Background="#FF6C757D" 
                               Foreground="White" 
                               BorderThickness="0"
                               Padding="10,5"
                               Click="BtnClear_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#FFF8F9FA">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
