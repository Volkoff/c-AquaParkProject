<Window x:Class="AquaParkManager.Windows.ReportsAnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
    Title="Reports and Analytics" Height="700" Width="1200" WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="15">
            <StackPanel>
                <TextBlock Text="📊 Reports And Analytics" Style="{StaticResource HeaderTitleStyle}"/>
                <TextBlock Text="Revenue, occupancy, loyalty, and weather insights" Style="{StaticResource HeaderSubTitleStyle}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1">
            <!-- Revenue Report Tab -->
            <TabItem Header="Revenue Report">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <DatePicker x:Name="dpRevenueFrom" Width="120"/>
                        <TextBlock Text="To:" VerticalAlignment="Center" Margin="20,0,10,0"/>
                        <DatePicker x:Name="dpRevenueTo" Width="120"/>
                        <Button x:Name="btnGenerateRevenue" Content="📈 Generate Report" Width="160" Height="30" Margin="20,0,0,0" Click="BtnGenerateRevenue_Click" Style="{StaticResource PrimaryActionButtonStyle}"/>
                    </StackPanel>

                    <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Total Bookings Revenue" FontWeight="Bold"/>
                                <TextBlock x:Name="txtBookingsRevenue" FontSize="24" Foreground="Green" Text="€0.00"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Concession Sales" FontWeight="Bold"/>
                                <TextBlock x:Name="txtConcessionRevenue" FontSize="24" Foreground="Blue" Text="€0.00"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Total Revenue" FontWeight="Bold"/>
                                <TextBlock x:Name="txtTotalRevenue" FontSize="24" Foreground="DarkGreen" Text="€0.00"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="2" x:Name="dgRevenueDetails" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:dd.MM.yyyy}'}" Width="100"/>
                            <DataGridTextColumn Header="Bookings" Binding="{Binding BookingsRevenue, StringFormat='{}{0:C}'}" Width="120"/>
                            <DataGridTextColumn Header="Concessions" Binding="{Binding ConcessionsRevenue, StringFormat='{}{0:C}'}" Width="120"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalRevenue, StringFormat='{}{0:C}'}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Occupancy Tracking Tab -->
            <TabItem Header="Occupancy Tracking">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Area:" VerticalAlignment="Center" Width="60"/>
                        <ComboBox x:Name="cmbOccupancyArea" DisplayMemberPath="Name" SelectedValuePath="PoolId" Width="200" Margin="5,0"/>
                        <TextBlock Text="Visitor Count:" VerticalAlignment="Center" Width="100" Margin="20,0,0,0"/>
                        <TextBox x:Name="txtVisitorCount" Width="80" Margin="5,0"/>
                        <Button x:Name="btnRecordOccupancy" Content="📥 Record Now" Width="120" Height="30" Margin="20,0,0,0" Click="BtnRecordOccupancy_Click" Style="{StaticResource AddButtonStyle}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="dgOccupancy" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Area" Binding="{Binding Area.Name}" Width="150"/>
                            <DataGridTextColumn Header="Recorded Time" Binding="{Binding RecordedTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="150"/>
                            <DataGridTextColumn Header="Visitor Count" Binding="{Binding VisitorCount}" Width="100"/>
                            <DataGridTextColumn Header="Capacity %" Binding="{Binding CapacityPercentage}" Width="100"/>
                            <DataGridTemplateColumn Header="Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2" x:Name="btnRefreshOccupancy" Content="🔄 Refresh Data" Width="120" Height="30" Margin="0,10,0,0" HorizontalAlignment="Right" Click="BtnRefreshOccupancy_Click" Style="{StaticResource NeutralButtonStyle}"/>
                </Grid>
            </TabItem>

            <!-- Loyalty & Memberships Tab -->
            <TabItem Header="Loyalty and Memberships">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Active Memberships" Margin="0,0,0,10">
                        <DataGrid x:Name="dgMemberships" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Visitor" Binding="{Binding Visitor.FullName}" Width="150"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding MembershipType}" Width="120"/>
                                <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="100"/>
                                <DataGridTextColumn Header="End Date" Binding="{Binding EndDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="100"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Loyalty Points Summary">
                        <DataGrid x:Name="dgLoyaltyPoints" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Visitor" Binding="{Binding Visitor.FullName}" Width="150"/>
                                <DataGridTextColumn Header="Points Earned" Binding="{Binding PointsEarned}" Width="120"/>
                                <DataGridTextColumn Header="Points Redeemed" Binding="{Binding PointsRedeemed}" Width="120"/>
                                <DataGridTextColumn Header="Available Points" Binding="{Binding AvailablePoints}" Width="120"/>
                                <DataGridTextColumn Header="Tier" Binding="{Binding Tier}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Weather Conditions Tab -->
            <TabItem Header="Weather Conditions">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Area:" VerticalAlignment="Center" Width="60"/>
                        <ComboBox x:Name="cmbWeatherArea" DisplayMemberPath="Name" SelectedValuePath="PoolId" Width="150" Margin="5,0"/>
                        <TextBlock Text="Temp (°C):" VerticalAlignment="Center" Width="80" Margin="10,0,0,0"/>
                        <TextBox x:Name="txtTemperature" Width="60" Margin="5,0"/>
                        <TextBlock Text="Type:" VerticalAlignment="Center" Width="50" Margin="10,0,0,0"/>
                        <ComboBox x:Name="cmbWeatherType" Width="100" Margin="5,0">
                            <ComboBoxItem Content="Sunny"/>
                            <ComboBoxItem Content="Cloudy"/>
                            <ComboBoxItem Content="Rainy"/>
                            <ComboBoxItem Content="Stormy"/>
                        </ComboBox>
                        <TextBlock Text="Status:" VerticalAlignment="Center" Width="60" Margin="10,0,0,0"/>
                        <ComboBox x:Name="cmbOperationalStatus" Width="100" Margin="5,0">
                            <ComboBoxItem Content="NORMAL" IsSelected="True"/>
                            <ComboBoxItem Content="REDUCED"/>
                            <ComboBoxItem Content="CLOSED"/>
                        </ComboBox>
                        <Button x:Name="btnRecordWeather" Content="📥 Record" Width="100" Height="30" Margin="20,0,0,0" Click="BtnRecordWeather_Click" Style="{StaticResource AddButtonStyle}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="dgWeather" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Area" Binding="{Binding Area.Name}" Width="120"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding RecordDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="140"/>
                            <DataGridTextColumn Header="Temperature" Binding="{Binding Temperature}" Width="100"/>
                            <DataGridTextColumn Header="Weather Type" Binding="{Binding WeatherType}" Width="120"/>
                            <DataGridTextColumn Header="Operational Status" Binding="{Binding OperationalStatus}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Background="{StaticResource StatusBarBrush}">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
