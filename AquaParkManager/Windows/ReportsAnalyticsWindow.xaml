<Window x:Class="AquaParkManager.Windows.ReportsAnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reports and Analytics" Height="700" Width="1200" WindowStartupLocation="CenterScreen" Background="White">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="15">
            <StackPanel>
                <TextBlock Text="📊 Reports And Analytics" Style="{StaticResource HeaderTitleStyle}"/>
                <TextBlock Text="Revenue, occupancy, loyalty, and system structure" Style="{StaticResource HeaderSubTitleStyle}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Denní Tržba (Procedura)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Vyberte datum:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <DatePicker x:Name="dpRevenueDate" Width="150"/>
                        <Button x:Name="btnCalcRevenue" Content="Spočítat tržbu (SP_DAILY_REVENUE)" Click="BtnCalcRevenue_Click" Margin="20,0,0,0" Padding="10,5" Background="#28A745" Foreground="White"/>
                    </StackPanel>

                    <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="20" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Výsledek z databáze:" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                            <TextBlock x:Name="txtRevenueResult" Text="---" FontSize="24" Foreground="#2E86AB"/>
                            <TextBlock Text="(Kalkulováno uloženou procedurou)" FontStyle="Italic" Foreground="Gray" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Struktura Areálu (Hierarchie)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Hierarchický pohled na oblasti parku (V_AREA_HIERARCHY):" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="dgHierarchy" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="50"/>
                            <DataGridTextColumn Header="Název" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Cesta (Path)" Binding="{Binding PathText}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>

        <StatusBar Grid.Row="2" Background="{StaticResource StatusBarBrush}">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>