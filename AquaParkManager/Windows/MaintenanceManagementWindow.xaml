<Window x:Class="AquaParkManager.Windows.MaintenanceManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maintenance Management" Height="500" Width="1000" WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="15">
            <StackPanel>
                <TextBlock Text="🔧 Maintenance Management" Style="{StaticResource HeaderTitleStyle}" />
                <TextBlock Text="Manage operational logs (DB stores Description and Date only)" Style="{StaticResource HeaderSubTitleStyle}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Maintenance Records" FontWeight="Bold">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="txtSearch" Width="200" Height="30" VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                        <Button x:Name="btnAddMaintenance" Content="➕ Add Record" Margin="10,0,0,0" Padding="15,5" Style="{StaticResource AddButtonStyle}" Click="BtnAddMaintenance_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="dgMaintenance" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="DgMaintenance_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding MaintenanceId}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Reported By" Binding="{Binding Staff.FullName}" Width="100"/>
                            <DataGridTextColumn Header="Report Date" Binding="{Binding ReportDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Details" FontWeight="Bold" Foreground="White">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="Attraction / Pool ID (Related ID):" FontWeight="Bold" Margin="0,0,0,5" Foreground="White"/>
                        <ComboBox x:Name="cmbAttraction" Margin="0,0,0,10"/>

                        <TextBlock Text="Reported By:" FontWeight="Bold" Margin="0,0,0,5" Foreground="White"/>
                        <ComboBox x:Name="cmbStaff" Margin="0,0,0,10"/>

                        <TextBlock Text="Report Date:" FontWeight="Bold" Margin="0,0,0,5" Foreground="White"/>
                        <DatePicker x:Name="dpReportDate" Margin="0,0,0,10"/>

                        <TextBlock Text="Problem Description:" FontWeight="Bold" Margin="0,0,0,5" Foreground="White"/>
                        <TextBox x:Name="txtProblemDescription" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

                        <Button x:Name="btnSave" Content="💾 Save" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,0,0,5" Click="BtnSave_Click"/>
                        <Button x:Name="btnDelete" Content="🗑️ Delete" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,5" Click="BtnDelete_Click"/>
                        <Button x:Name="btnClear" Content="🔄 Clear" Style="{StaticResource NeutralButtonStyle}" Click="BtnClear_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="2" Background="{StaticResource StatusBarBrush}">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>