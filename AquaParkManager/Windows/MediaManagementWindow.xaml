<Window x:Class="AquaParkManager.Windows.MediaManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media &amp; BLOB Management" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Blue bar with title and description -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="15">
            <StackPanel>
                <TextBlock Text="🎬 Media and BLOB Management" Style="{StaticResource HeaderTitleStyle}"/>
                <TextBlock Text="Manage media assets (images, videos) stored as BLOBs and preview them" Style="{StaticResource HeaderSubTitleStyle}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Name="btnUpload" Content="📂 Upload New Image (BLOB)" Click="BtnUpload_Click" Margin="0,0,0,10" Padding="10,5" Style="{StaticResource AddButtonStyle}"/>
                <DataGrid Name="dgMedia" Grid.Row="1" AutoGenerateColumns="False" SelectionChanged="DgMedia_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding MediaId}" Width="50"/>
                    <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding MimeType}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

            <Border Grid.Column="1" Margin="10,0,0,0" BorderBrush="Gray" BorderThickness="1">
                <Image Name="imgPreview" Stretch="Uniform"/>
            </Border>
        </Grid>

        <!-- Status bar at bottom -->
        <StatusBar Grid.Row="2" Background="{StaticResource StatusBarBrush}">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>