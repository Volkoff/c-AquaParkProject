<Window x:Class="AquaParkManager.Windows.MediaManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media &amp; BLOB Management" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Name="btnUpload" Content="📂 Upload New Image (BLOB)" Click="BtnUpload_Click" Margin="0,0,0,10" Padding="5"/>
            <DataGrid Name="dgMedia" Grid.Row="1" AutoGenerateColumns="False" SelectionChanged="DgMedia_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding MediaId}" Width="50"/>
                    <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding MimeType}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Column="1" Margin="10,0,0,0" BorderBrush="Gray" BorderThickness="1">
            <Image Name="imgPreview" Stretch="Uniform"/>
        </Border>
    </Grid>
</Window>