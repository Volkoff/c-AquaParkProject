<Window x:Class="AquaParkManager.Windows.CertificationsManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Certifications Management" Height="700" Width="1100" WindowStartupLocation="CenterScreen" Background="White">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="15">
            <StackPanel>
                <TextBlock Text="📜 Staff Certifications Management" Style="{StaticResource HeaderTitleStyle}"/>
                <TextBlock Text="Manage and monitor staff certifications with expiry tracking" Style="{StaticResource HeaderSubTitleStyle}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="txtSearch" Width="300" TextChanged="TxtSearch_TextChanged"/>
                <CheckBox x:Name="chkExpiring" Content="Show Expiring Soon" Margin="20,0,0,0" Checked="ChkExpiring_Checked" Unchecked="ChkExpiring_Unchecked"/>
                <CheckBox x:Name="chkExpired" Content="Show Expired" Margin="20,0,0,0" Checked="ChkExpired_Checked" Unchecked="ChkExpired_Unchecked"/>
            </StackPanel>

            <!-- DataGrid -->
            <DataGrid Grid.Row="1" x:Name="dgCertifications" AutoGenerateColumns="False" 
                      IsReadOnly="True" SelectionMode="Single" SelectionChanged="DgCertifications_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding CertId}" Width="50"/>
                    <DataGridTextColumn Header="Staff" Binding="{Binding Staff.FullName}" Width="150"/>
                    <DataGridTextColumn Header="Certification" Binding="{Binding CertName}" Width="200"/>
                    <DataGridTextColumn Header="Issued By" Binding="{Binding IssuedBy}" Width="120"/>
                    <DataGridTextColumn Header="Issued Date" Binding="{Binding IssuedDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="100"/>
                    <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding VerificationStatus}" Width="100"/>
                    <DataGridTemplateColumn Header="Alert" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AlertText}" Foreground="{Binding AlertColor}" FontWeight="Bold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Form -->
            <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Padding="15" Margin="0,20,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,10">
                        <TextBlock Text="Staff:"/>
                        <ComboBox x:Name="cmbStaff" DisplayMemberPath="FullName" SelectedValuePath="StaffId"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,10,10">
                        <TextBlock Text="Certification Name:*"/>
                        <TextBox x:Name="txtCertName"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Issued By:"/>
                        <TextBox x:Name="txtIssuedBy"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,10,10">
                        <TextBlock Text="Issued Date:"/>
                        <DatePicker x:Name="dpIssuedDate"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,10,10">
                        <TextBlock Text="Expiry Date:"/>
                        <DatePicker x:Name="dpExpiryDate"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="Verification Status:"/>
                        <ComboBox x:Name="cmbStatus">
                            <ComboBoxItem Content="PENDING" IsSelected="True"/>
                            <ComboBoxItem Content="VERIFIED"/>
                            <ComboBoxItem Content="EXPIRED"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Margin="0,0,0,0">
                        <TextBlock Text="Notes:"/>
                        <TextBox x:Name="txtNotes" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>

                <!-- Buttons moved into inner grid (Row 3) so StatusBar at bottom does not overlap form -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,20,20">
                <Button x:Name="btnAdd" Content="➕ Add New" Width="110" Height="30" Margin="0,0,10,0" Click="BtnAdd_Click" Style="{StaticResource AddButtonStyle}"/>
                <Button x:Name="btnUpdate" Content="💾 Update" Width="100" Height="30" Margin="0,0,10,0" Click="BtnUpdate_Click" Style="{StaticResource PrimaryActionButtonStyle}"/>
                <Button x:Name="btnDelete" Content="🗑️ Delete" Width="100" Height="30" Margin="0,0,10,0" Click="BtnDelete_Click" Style="{StaticResource DangerButtonStyle}"/>
                <Button x:Name="btnClear" Content="🔄 Clear" Width="100" Height="30" Click="BtnClear_Click" Style="{StaticResource NeutralButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>