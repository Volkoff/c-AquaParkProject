<Window x:Class="AquaParkManager.Windows.SchedulingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Staff Scheduling" Height="600" Width="1000" WindowStartupLocation="CenterScreen">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="15">
            <StackPanel>
                <TextBlock Text="📆 Staff Scheduling" Style="{StaticResource HeaderTitleStyle}"/>
                <TextBlock Text="Define shifts and manage staff assignments" Style="{StaticResource HeaderSubTitleStyle}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1">
            <!-- Shifts Tab -->
            <TabItem Header="Shifts">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" x:Name="dgShifts" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgShifts_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ShiftId}" Width="50"/>
                            <DataGridTextColumn Header="Shift Name" Binding="{Binding ShiftName}" Width="150"/>
                            <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime, StringFormat='{}{0:HH:mm}'}" Width="100"/>
                            <DataGridTextColumn Header="End Time" Binding="{Binding EndTime, StringFormat='{}{0:HH:mm}'}" Width="100"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10">
                        <TextBlock Text="Shift Name:" VerticalAlignment="Center" Width="100"/>
                        <TextBox x:Name="txtShiftName" Width="150" Margin="5,0"/>
                        <TextBlock Text="Start:" VerticalAlignment="Center" Width="50" Margin="10,0,0,0"/>
                        <TextBox x:Name="txtStartTime" Width="80" Margin="5,0"/>
                        <TextBlock Text="End:" VerticalAlignment="Center" Width="40" Margin="10,0,0,0"/>
                        <TextBox x:Name="txtEndTime" Width="80" Margin="5,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="btnAddShift" Content="➕ Add Shift" Width="110" Height="30" Margin="0,0,10,0" Click="BtnAddShift_Click" Style="{StaticResource AddButtonStyle}"/>
                        <Button x:Name="btnDeleteShift" Content="🗑️ Delete" Width="100" Height="30" Click="BtnDeleteShift_Click" Style="{StaticResource DangerButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Staff Assignments Tab -->
            <TabItem Header="Staff Assignments">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Filter Date:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <DatePicker x:Name="dpFilterDate" SelectedDateChanged="DpFilterDate_SelectedDateChanged"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="dgStaffShifts" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Staff" Binding="{Binding Staff.FullName}" Width="150"/>
                            <DataGridTextColumn Header="Shift" Binding="{Binding Shift.ShiftName}" Width="150"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding ShiftDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="100"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding ShiftTime}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Staff:" VerticalAlignment="Center" Width="60"/>
                            <ComboBox x:Name="cmbStaffAssign" DisplayMemberPath="FullName" SelectedValuePath="StaffId" Width="180" Margin="5,0"/>
                            <TextBlock Text="Shift:" VerticalAlignment="Center" Width="50" Margin="10,0,0,0"/>
                            <ComboBox x:Name="cmbShiftAssign" DisplayMemberPath="ShiftName" SelectedValuePath="ShiftId" Width="150" Margin="5,0"/>
                            <TextBlock Text="Date:" VerticalAlignment="Center" Width="50" Margin="10,0,0,0"/>
                            <DatePicker x:Name="dpAssignDate" Width="120" Margin="5,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" x:Name="btnAssignShift" Content="💾 Assign Shift" Width="120" Height="30" Click="BtnAssignShift_Click" Style="{StaticResource PrimaryActionButtonStyle}"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        
        <StatusBar Grid.Row="2" Background="{StaticResource StatusBarBrush}">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
