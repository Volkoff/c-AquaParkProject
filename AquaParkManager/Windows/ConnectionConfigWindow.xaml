<Window x:Class="AquaParkManager.Windows.ConnectionConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database Connection" Height="380" Width="450" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Icon="Resources/water_drop.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="🔗 Database Connection" Style="{StaticResource HeaderTitleStyle}"/>
            <TextBlock Text="Enter Oracle connection settings" Style="{StaticResource HeaderSubTitleStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Host:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtHost" Grid.Row="0" Grid.Column="1" Margin="0,4" Text="fei-sql3.upceucebny.cz"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtPort" Grid.Row="1" Grid.Column="1" Margin="0,4" Text="1521"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="SID:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtSid" Grid.Row="2" Grid.Column="1" Margin="0,4" Text="BDAS"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="User Id:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtUser" Grid.Row="3" Grid.Column="1" Margin="0,4" Text=""/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Password:" VerticalAlignment="Center"/>
            <PasswordBox x:Name="txtPassword" Grid.Row="4" Grid.Column="1" Margin="0,4"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnTest" Content="Test" Style="{StaticResource NeutralButtonStyle}" Margin="0,0,8,0" Click="BtnTest_Click"/>
            <Button x:Name="btnConnect" Content="Connect" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,0,8,0" Click="BtnConnect_Click"/>
            <Button x:Name="btnCancel" Content="Cancel" Style="{StaticResource NeutralButtonStyle}" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
