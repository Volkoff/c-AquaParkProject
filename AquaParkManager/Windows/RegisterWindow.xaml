<Window x:Class="AquaParkManager.Windows.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrace" Height="550" Width="400" WindowStartupLocation="CenterScreen">
    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="Nová Registrace" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <GroupBox Header="Přihlášení">
                <StackPanel Margin="5">
                    <TextBlock Text="Email (Login):"/>
                    <TextBox x:Name="txtEmail" Margin="0,0,0,5"/>
                    <TextBlock Text="Heslo:"/>
                    <PasswordBox x:Name="txtPassword" Margin="0,0,0,5"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Osobní údaje">
                <StackPanel Margin="5">
                    <TextBlock Text="Jméno:"/>
                    <TextBox x:Name="txtFirstName" Margin="0,0,0,5"/>
                    <TextBlock Text="Příjmení:"/>
                    <TextBox x:Name="txtLastName" Margin="0,0,0,5"/>
                    <TextBlock Text="Datum narození:"/>
                    <DatePicker x:Name="dpDob" Margin="0,0,0,5"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Adresa (Povinné)">
                <StackPanel Margin="5">
                    <TextBlock Text="Ulice:"/>
                    <TextBox x:Name="txtStreet" Margin="0,0,0,5"/>
                    <TextBlock Text="Číslo popisné:"/>
                    <TextBox x:Name="txtHouseNumber" Margin="0,0,0,5"/>
                    <TextBlock Text="Město:"/>
                    <TextBox x:Name="txtCity" Margin="0,0,0,5"/>
                    <TextBlock Text="PSČ:"/>
                    <TextBox x:Name="txtZip" Margin="0,0,0,5"/>
                </StackPanel>
            </GroupBox>

            <Button Content="Registrovat se" Click="BtnRegister_Click" Height="30" Margin="0,15,0,0" Background="#28A745" Foreground="White"/>
        </StackPanel>
    </ScrollViewer>
</Window>