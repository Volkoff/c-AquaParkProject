<Window x:Class="AquaParkManager.Windows.GuestBookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nákup Vstupenek" Height="700" Width="800" WindowStartupLocation="CenterScreen" Background="White">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF2E86AB"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2E86AB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF2E86AB" Padding="30">
            <StackPanel>
                <TextBlock Text="🎫 Nákup Vstupenek" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Vyberte si vstupenky a koupu jste rezervaci automaticky vytvořena" FontSize="12" Foreground="#EEE" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">
                <!-- Reservation Date -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="📅 Datum Rezervace" Style="{StaticResource HeaderStyle}"/>
                        <DatePicker x:Name="dpReservationDate" Padding="10" FontSize="14" Background="#FFF8F9FA" BorderThickness="1" BorderBrush="#FFE0E0E0"/>
                        <TextBlock x:Name="lblDateError" Text="" Foreground="Red" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Reservation Time -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="🕐 Čas Rezervace" Style="{StaticResource HeaderStyle}"/>
                        <TextBox x:Name="txtReservationTime" Padding="10" FontSize="14" Background="#FFF8F9FA" BorderThickness="1" BorderBrush="#FFE0E0E0"/>
                        <TextBlock Text="Zadejte čas ve formátu HH:mm (např. 14:30)" FontSize="11" Foreground="Gray" Margin="0,3,0,0"/>
                        <TextBlock x:Name="lblTimeError" Text="" Foreground="Red" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Ticket Selection -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="🎟️ Vyberte Vstupenky" Style="{StaticResource HeaderStyle}"/>
                        <ItemsControl x:Name="icTickets" Background="Transparent">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#FFE0E0E0" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Ticket Info -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#FF2E86AB"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="Gray" Margin="0,3,0,0"/>
                                                <TextBlock x:Name="lblPrice" FontSize="13" FontWeight="Bold" Foreground="Green" Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <!-- Quantity Input -->
                                            <TextBlock Grid.Column="1" Text="Počet:" VerticalAlignment="Center" Margin="20,0,10,0" FontWeight="Bold"/>
                                            <TextBox Grid.Column="2" x:Name="txtQuantity" Text="0" Width="60" Padding="8" FontSize="13" Background="#FFF8F9FA" BorderThickness="1" BorderBrush="#FFE0E0E0" TextAlignment="Center" PreviewTextInput="TxtQuantity_PreviewTextInput"/>

                                            <!-- Price Display -->
                                            <TextBlock Grid.Column="3" x:Name="lblLinePrice" Text="0 Kč" FontSize="13" FontWeight="Bold" Foreground="#FF2E86AB" VerticalAlignment="Center" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Summary -->
                <Border Style="{StaticResource CardStyle}" Background="#FFF0F8FF">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="📊 Souhrn Nákupu" Style="{StaticResource HeaderStyle}"/>
                            <TextBlock x:Name="lblTicketCount" Text="Počet vstupenek: 0" FontSize="13" Margin="0,5,0,3"/>
                            <TextBlock x:Name="lblTotalPrice" Text="Cena celkem: 0 Kč" FontSize="16" FontWeight="Bold" Foreground="Green"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Cena:" FontSize="12" Foreground="Gray" TextAlignment="Right"/>
                            <TextBlock x:Name="lblBigPrice" Text="0 Kč" FontSize="24" FontWeight="Bold" Foreground="#FF2E86AB" TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="lblStatus" Text="" Foreground="Green" FontSize="12" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Buttons -->
        <Border Grid.Row="2" Background="#FFF8F9FA" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Padding="30">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnPurchase" Content="✅ Koupit Vstupenky" Click="BtnPurchase_Click" Background="#FF28A745" Padding="25,12" FontSize="14" FontWeight="Bold" Foreground="White" Cursor="Hand" Margin="0,0,10,0"/>
                <Button Content="❌ Zrušit" Click="BtnCancel_Click" Background="#FFC3E1FA" Foreground="#FF2E86AB" Padding="20,12" FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
