<Window x:Class="AquaParkManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AquaParkManager"
        mc:Ignorable="d"
        Title="Aqua Park Manager" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2E86AB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1F5F7A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF164A5C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#FF2E86AB" Padding="20">
            <StackPanel>
                <TextBlock Text="Aqua Park Management System" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="White" 
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Manage your aqua park operations" 
                          FontSize="14" 
                          Foreground="White" 
                          HorizontalAlignment="Center" 
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Background="#FFF8F9FA">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Navigation Menu -->
            <Border Grid.Column="0" Background="White" BorderBrush="#FFE0E0E0" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Management Modules" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Core Operations" FontSize="12" FontWeight="Bold" Foreground="#FF666666" Margin="0,0,0,5"/>
                        
                        <Button x:Name="btnStaff" Content="👥 Staff Management" 
                               Style="{StaticResource MenuButtonStyle}" 
                               Click="BtnStaff_Click" Margin="0,0,0,10"/>
                        
                        <Button x:Name="btnPools" Content="🏊 Pools Management" 
                               Style="{StaticResource MenuButtonStyle}" 
                               Click="BtnPools_Click" Margin="0,0,0,10"/>
                        
                        <Button x:Name="btnSlides" Content="🎢 Slides Management" 
                               Style="{StaticResource MenuButtonStyle}" 
                               Click="BtnSlides_Click" Margin="0,0,0,10"/>
                        
                        <Button x:Name="btnVisitors" Content="👤 Visitors Management" 
                               Style="{StaticResource MenuButtonStyle}" 
                               Click="BtnVisitors_Click" Margin="0,0,0,10"/>
                        
                        <Button x:Name="btnTickets" Content="🎫 Tickets Management" 
                               Style="{StaticResource MenuButtonStyle}" 
                               Click="BtnTickets_Click" Margin="0,0,0,10"/>
                        
                        <Button x:Name="btnBookings" Content="📅 Bookings Management" 
                               Style="{StaticResource MenuButtonStyle}" 
                               Click="BtnBookings_Click" Margin="0,0,0,10"/>
                        
                        <Button x:Name="btnMaintenance" Content="🔧 Maintenance Records" 
                               Style="{StaticResource MenuButtonStyle}" 
                               Click="BtnMaintenance_Click" Margin="0,0,0,10"/>
                        
                        <Separator Margin="0,10,0,10"/>
                        <TextBlock Text="Advanced Features" FontSize="12" FontWeight="Bold" Foreground="#FF666666" Margin="0,0,0,5"/>
                        
                        <Button x:Name="btnCertifications" Content="📜 Certifications" 
                               Style="{StaticResource MenuButtonStyle}" 
                               Click="BtnCertifications_Click" Margin="0,0,0,10"/>
                        
                        <Button x:Name="btnInventory" Content="📦 Inventory Management" 
                               Style="{StaticResource MenuButtonStyle}" 
                               Click="BtnInventory_Click" Margin="0,0,0,10"/>
                        
                        <Button x:Name="btnScheduling" Content="📆 Staff Scheduling" 
                               Style="{StaticResource MenuButtonStyle}" 
                               Click="BtnScheduling_Click" Margin="0,0,0,10"/>
                        
                        <Button x:Name="btnReports" Content="📊 Reports Analytics" 
                               Style="{StaticResource MenuButtonStyle}" 
                               Click="BtnReports_Click" Margin="0,0,0,10"/>
                        
                        <Button x:Name="btnMedia" Content="🎬 Media Management" 
                               Style="{StaticResource MenuButtonStyle}" 
                               Click="BtnMedia_Click" Margin="0,0,0,10"/>

                       
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Content Area -->
            <Grid Grid.Column="1" Margin="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🏊‍♂️" FontSize="80" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Welcome to Aqua Park Manager" 
                              FontSize="24" 
                              FontWeight="Bold" 
                              HorizontalAlignment="Center" 
                              Margin="0,0,0,10"/>
                    <TextBlock Text="Select a management module from the left menu to get started." 
                              FontSize="14" 
                              Foreground="#FF666666" 
                              HorizontalAlignment="Center" 
                              TextWrapping="Wrap" 
                              TextAlignment="Center" 
                              MaxWidth="400"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
