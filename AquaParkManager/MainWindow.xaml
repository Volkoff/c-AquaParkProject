<Window x:Class="AquaParkManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aqua Park Manager" Height="700" Width="1100" WindowStartupLocation="CenterScreen" Background="White" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2E86AB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF2E86AB" Padding="20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Aqua Park Management System" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtUserStatus" Text="Nepřihlášený uživatel" FontSize="14" Foreground="#EEE" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                <Button x:Name="btnLogin" Content="Login" Click="BtnLogin_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="15,5" Background="White" Foreground="#FF2E86AB" FontWeight="Bold" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- Emulation Status Bar -->
        <Border Grid.Row="1" Background="#FF8B0000" Padding="15" x:Name="pnlEmulationStatus" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠️ MODE: EMULACE UŽIVATELE" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Button x:Name="btnReturnToAdmin" Content="← Vrátit se na ADMIN" Background="White" Foreground="#FF8B0000" Padding="15,8" FontWeight="Bold" Click="BtnReturnToAdmin_Click" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Background="#FFF8F9FA" x:Name="grdMainContent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#FFE0E0E0" BorderThickness="0,0,1,0">
                <ScrollViewer>
                    <StackPanel Margin="15">
                        <TextBlock Text="Veřejné" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,5"/>
                        <Button x:Name="btnTickets" Content="🎫 Vstupenky" Click="BtnTickets_Click" Style="{StaticResource MenuButtonStyle}"/>
                        <Button x:Name="btnPools" Content="🏊 Bazény" Click="BtnPools_Click" Style="{StaticResource MenuButtonStyle}"/>
                        <Button x:Name="btnSlides" Content="🎢 Tobogány" Click="BtnSlides_Click" Style="{StaticResource MenuButtonStyle}"/>
                        <Button x:Name="btnBookings" Content="📅 Rezervace" Click="BtnBookings_Click" Style="{StaticResource MenuButtonStyle}"/>
                        <Button x:Name="btnMembership" Content="💳 Členství" Click="BtnMembership_Click" Style="{StaticResource MenuButtonStyle}"/>

                        <StackPanel x:Name="pnlAdminModules" Visibility="Collapsed">
                            <Separator Margin="0,15"/>
                            <TextBlock Text="Správa" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,5"/>
                            <Button x:Name="btnStaff" Content="👥 Zaměstnanci" Click="BtnStaff_Click" Style="{StaticResource MenuButtonStyle}"/>
                            <Button x:Name="btnVisitors" Content="👤 Návštěvníci" Click="BtnVisitors_Click" Style="{StaticResource MenuButtonStyle}"/>
                            <Button x:Name="btnMaintenance" Content="🔧 Údržba" Click="BtnMaintenance_Click" Style="{StaticResource MenuButtonStyle}"/>
                            <Button x:Name="btnInventory" Content="📦 Sklad" Click="BtnInventory_Click" Style="{StaticResource MenuButtonStyle}"/>
                            <Button x:Name="btnCertifications" Content="📜 Certifikace" Click="BtnCertifications_Click" Style="{StaticResource MenuButtonStyle}"/>
                            <Button x:Name="btnScheduling" Content="📆 Plánování" Click="BtnScheduling_Click" Style="{StaticResource MenuButtonStyle}"/>
                            <Button x:Name="btnReports" Content="📊 Reporty" Click="BtnReports_Click" Style="{StaticResource MenuButtonStyle}"/>
                            <Button x:Name="btnMedia" Content="🎬 Média" Click="BtnMedia_Click" Style="{StaticResource MenuButtonStyle}"/>

                            <Button x:Name="btnUsers" Content="🔐 Uživatelé (Admin)" Click="BtnUsers_Click" Style="{StaticResource MenuButtonStyle}" Background="Orange"/>
                            <Button x:Name="btnDbInfo" Content="ℹ️ DB Katalog" Click="BtnDbInfo_Click" Style="{StaticResource MenuButtonStyle}" Background="Gray"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Margin="30">
                <TextBlock Text="Vítejte v systému Aqua Park!" FontSize="32" Foreground="#CCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>