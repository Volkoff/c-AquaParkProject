<Window x:Class="AquaParkManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AquaPark Manager - Main Menu" Height="500" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,20,0,30">
            <TextBlock Text="Main Menu" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Select a module to continue" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="10">
            <Button Click="BtnFac_Click" Margin="10">
                <StackPanel>
                    <TextBlock Text="🏭" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="FACILITIES" FontWeight="Bold" Margin="0,10,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Pools, Attractions, Inventory" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Click="BtnHR_Click" Margin="10">
                <StackPanel>
                    <TextBlock Text="👥" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="HR &amp; STAFF" FontWeight="Bold" Margin="0,10,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Employees, Shifts, Roles" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Click="BtnSales_Click" Margin="10">
                <StackPanel>
                    <TextBlock Text="💰" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="SALES" FontWeight="Bold" Margin="0,10,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Bookings, Visitors, Payments" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </Grid>
</Window>