<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Oracle.EntityFrameworkCore" Version="8.23.60" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.10" />
		
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10" />
	</ItemGroup>

	<ItemGroup>
		<!-- Keep the original file name on disk but expose a clean logical name for pack URIs to avoid spaces. -->
		<Resource Include="Resources\pngimg.com - water_splash_PNG72.png">
			<LogicalName>Resources/bg_img.png</LogicalName>
		</Resource>
		<Resource Include="Resources\water_drop.ico">
			<LogicalName>Resources/water_drop.ico</LogicalName>
		</Resource>
	</ItemGroup>

</Project>